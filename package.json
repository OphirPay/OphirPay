{
  "name": "ophirpay",
  "version": "0.1.0",
  "private": true,
  "description": "OphirPay",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "prepare": "husky install"
  },
  "dependencies": {
    "nodemailer": "^6.9.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "next": "^13.5.4",
    "prisma": "^5.10.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.5.7",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.2.2",
    "eslint": "^8.48.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json", "node"],
    "testMatch": ["**/tests/**/*.test.(ts|tsx)"],
    "coverageDirectory": "./coverage/",
    "coverageReporters": ["json", "lcov", "text", "clover"]
  }
}
