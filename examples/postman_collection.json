            "description": "Creates and executes an atomic multi-transfer payment batch."
          }
        },
        {
          "name": "Get Batch Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/batches/batch_1234567890",
              "host": ["{{baseUrl}}"],
              "path": ["api", "batches", "batch_1234567890"]
            },
            "description": "Inspects status and individual item execution statuses of a payment batch."
          }
        }
      ]
    },
    {
      "name": "Escrows",
      "description": "Conditional escrow creation, milestone vesting, and fund release.",
      "item": [
        {
          "name": "List Escrows",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/escrows?status=ACTIVE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "escrows"],
              "query": [
                { "key": "status", "value": "ACTIVE" }
              ]
            },
            "description": "Lists existing escrow agreements."
          }
        },
        {
          "name": "Create Escrow",
          "request": {
