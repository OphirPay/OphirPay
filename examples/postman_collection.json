            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"1000.00\",\n  \"asset\": \"native\",\n  \"beneficiary\": \"GB6NV2AA5UV67K5KBOVPYZBXOEAWETDBGZO2FS6KF5OHUKGLYBD45WPT\",\n  \"arbiter\": \"GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN\",\n  \"releaseTime\": 1735689600\n}"
