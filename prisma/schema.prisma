
model PaymentRequest {
  id                  String    @id @default(uuid())
  amount             BigInt
  currency           String
  memo               String?
  dueDate            DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  status             RequestStatus
  overdueAt          DateTime?
  reminderCount      Int       @default(0)
  lastReminderSent   DateTime?
  // ... existing fields ...

  @@index([status, overdueAt])
}

enum RequestStatus {
  PENDING
  OVERDUE
  PAID
  CANCELLED
  EXPIRED
}
