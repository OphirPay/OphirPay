{
  "version": 2,
  "buildCommand": "npx prisma generate && next build",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false,
    "productionBranch": "main"
  }
}
