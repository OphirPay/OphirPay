{
  "version": 2,
  "buildCommand": "npx prisma generate && next build",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "integration/staging": true
    }
  },
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false,
    "productionBranch": "main"
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/requests/expire",
      "schedule": "*/15 * * * *"
    }
  ]
}
