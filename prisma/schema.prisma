// src/prisma/schema.prisma

model ApiKey {
  id            String   @id @default(cuid())
  publicKey     String   @unique
  privateKey    String
  scopes        String[]
  createdAt     DateTime
  lastUsed      DateTime?
  revokedAt     DateTime?
  revokedBy     String?
  rotationOf    ApiKey?   @relation("rotation", fields: ["rotationOfId"], references: ["id"])
  rotationOfId String?
  rotatedTo     ApiKey?   @relation("rotation", fields: ["rotatedToId"], references: ["id"])
  rotatedToId  String?
  overlapExpires DateTime?

  @@index([rotationOfId])
  @@index([rotatedToId])
}

model ApiKeyRequestLog {
  id        String   @id @default(cuid())
  apiKeyId  String
  ipAddress String
  userAgent String
  timestamp DateTime
  action    String   // 'rotation', 'revocation', 'usage'
  metadata  Json?

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])
}