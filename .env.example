# ═══════════════════════════════════════════════════════════════
# OphirPay — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production, set these in your deployment platform
# (Vercel, Kubernetes secrets, Docker env, etc.)

# ── Database (Required) ────────────────────────────────────────
# PostgreSQL connection string. SQLite is local-dev-only and needs local
# schema edits; DATABASE_PROVIDER does not switch Prisma's datasource.
# See docs/DATABASE_PROVIDERS.md before using SQLite.
DATABASE_URL=postgresql://localhost:5432/ophirpay
DATABASE_PROVIDER=postgresql

# Optional direct PostgreSQL URL for migration tooling. The committed
# datasource currently uses DATABASE_URL; see docs/DATABASE_PROVIDERS.md
# before assuming DIRECT_DATABASE_URL is used by Prisma CLI commands.
# DIRECT_DATABASE_URL=postgresql://...

# ── Stellar Network (Required) ─────────────────────────────────
# Network switch: TESTNET (default) or PUBLIC (Stellar Mainnet).
# ⚠ WARNING: Switching to PUBLIC targets the live Stellar Mainnet.
#   - There is NO friendbot — you must fund the account with real XLM.
#   - Deployments are irreversible and cost real XLM.
#   - Only switch after reading docs/deployment-mainnet.md.
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org:443
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Mainnet overrides (uncomment ONLY for Stellar Mainnet) ─────
# ⚠ WARNING: These point at the live Stellar Mainnet. Do not enable
#   unless you have funded the deployer account with real XLM and
#   have deployed the contracts via scripts/deploy-workflow.sh.
# NEXT_PUBLIC_STELLAR_NETWORK=PUBLIC
# NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban.stellar.org:443
# NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# ── Smart Contracts (Required) ─────────────────────────────────
# Testnet defaults — works out of the box for local dev.
# Deploy your own via ./scripts/deploy-all.sh and paste IDs here for custom installs.
NEXT_PUBLIC_CONTRACT_ID=CCQGGUJRRVXMHNEX2RYPODGJE2YRMYY4Y7A3KTJH3QP2LWZLTCOPRPET
NEXT_PUBLIC_EMITTER_CONTRACT_ID=CDAVU2XJ7C2Y52GRJZKRG3HDI7AJ2K2FHAFH5FPDTSUQAV7XNBQNNVAN

# ── Mainnet contract IDs (placeholders — fill after deployment) ─
# ⚠ WARNING: These are placeholders. Replace with the real mainnet
#   contract IDs returned by scripts/deploy-workflow.sh before use.
# NEXT_PUBLIC_CONTRACT_ID=<MAINNET_OPHIRPAY_CONTRACT_ID>
# NEXT_PUBLIC_EMITTER_CONTRACT_ID=<MAINNET_EMITTER_CONTRACT_ID>

# ── App Configuration ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Authentication (Required in production) ────────────────────
# Signs wallet session cookies. Generate with: openssl rand -hex 32
# ⚠ This value is a PLACEHOLDER and MUST be replaced before deploying.
#   Production startup refuses to boot while AUTH_SECRET is the placeholder,
#   shorter than 32 bytes, or otherwise low-entropy (see src/lib/env.ts).
AUTH_SECRET=replace-with-openssl-rand-hex-32-output

# ── Transactional Email (Required to deliver email) ────────────
# Resend API key used by src/lib/email.ts over the Resend HTTPS API for
# payment confirmations and webhook-failure notices. Create one at
# https://resend.com/api-keys
# ⚠ Without it, sendEmail() throws EmailConfigurationError instead of
#   silently pretending the message was delivered (issue #800).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender identity for outbound mail. Must be a domain verified in Resend.
# Defaults to "OphirPay <payments@ophirpay.com>" when unset.
# EMAIL_FROM=OphirPay <payments@ophirpay.com>

# ── Scheduled Payments (Optional) ──────────────────────────────
# Secret key of the Stellar account that executes scheduled payments.
# The cron endpoint refuses to run without it. Generate with:
#   node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"
# SCHEDULED_PAYMENTS_SOURCE_SECRET=

# Protects /api/scheduled/run from public access. Vercel cron sends this as
# `Authorization: Bearer $CRON_SECRET`. Generate with: openssl rand -hex 32
# CRON_SECRET=

# ── Rate Limiting (Optional) ───────────────────────────────────
RATE_LIMIT_RPM=120

# Wallet-auth endpoints (/api/auth/challenge, /api/auth/session) get stricter
# per-IP and per-account buckets on top of the global RATE_LIMIT_RPM.
# Per-account buckets are keyed by the wallet's Stellar public key.
AUTH_RATE_LIMIT_IP_RPM=30
AUTH_RATE_LIMIT_WALLET_RPM=10

# Redis URL for distributed rate limiting (optional).
#
# The transport is chosen from the URL scheme because the global limiter in
# src/proxy.ts runs on the Edge runtime, where the ioredis TCP client cannot:
#
#   redis://…  or rediss://…  → ioredis, Node runtime only. The *edge* global
#                               limit falls back to per-instance memory, so
#                               use this only for the route-level buckets
#                               (auth / lookup) or when you run a single
#                               instance. (docker-compose uses this form.)
#   https://…                 → Upstash-compatible REST, shared by *every*
#                               replica on both runtimes. This is the form to
#                               use for real multi-instance protection.
#
# With REDIS_URL unset, limiting is per-instance in memory.
# REDIS_URL=redis://localhost:6379
# REDIS_URL=https://YOUR-DB.upstash.io
# Bearer token for hosted REST Redis (Upstash):
# REDIS_TOKEN=

# ── Monitoring (Optional) ──────────────────────────────────────
# Sentry reports client and server exceptions when configured. The DSN is
# public; never put Sentry auth tokens in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_GA_ID=

# Bearer token that protects the Prometheus scrape endpoint `/api/metrics`.
# Unauthenticated requests now get 401 — a scraper must send
# `Authorization: Bearer $METRICS_TOKEN`. Generate with: openssl rand -hex 32
# METRICS_TOKEN=

# ── Webhooks (Optional) ────────────────────────────────────────
# Comma-separated list of ports webhook targets may use. Defaults to 80,443;
# a subscriber whose endpoint listens on another port is rejected at delivery.
# WEBHOOK_ALLOWED_PORTS=80,443

# ── Asset Metadata (Optional) ──────────────────────────────────
# Custom-asset display names are resolved from the issuer's SEP-1
# stellar.toml (issue #824). The parsed document is cached per issuer domain;
# these TTLs (milliseconds) bound how stale that cache may get.
# ASSET_METADATA_TTL_MS=21600000   # 6 hours
# HOME_DOMAIN_TTL_MS=3600000       # 1 hour

# ── SEP-24 Anchor (Optional) ───────────────────────────────────
# Fiat on/off-ramp through a Stellar anchor's SEP-24 interactive flow
# (issue #821). The anchor's SEP-1 TOML is fetched from this domain — nothing
# about the anchor is hardcoded. KYC is performed by the anchor, not this app.
# NEXT_PUBLIC_ANCHOR_DOMAIN=testanchor.stellar.org
# Fiat amounts are shown/entered in this currency for the anchor:
# NEXT_PUBLIC_ANCHOR_FIAT_CURRENCY=USD
# TTL (ms) for the cached anchor metadata / transaction polling interval.
# ANCHOR_METADATA_TTL_MS=300000
# ANCHOR_POLL_INTERVAL_MS=5000
# ANCHOR_POLL_TIMEOUT_MS=600000

# ── Chain Read Source (Optional) ───────────────────────────────
# NEXT_PUBLIC_CHAIN_READ_SOURCE=

# ── Feature Flags (Optional) ───────────────────────────────────
# All NEXT_PUBLIC_FEATURE_* vars are inlined at build time by Next.js.
# Changing them requires a full rebuild + redeploy to take effect.
# See docs/FEATURE_FLAGS.md for the full reference and localStorage
# override instructions for local development.
#
# Opt-out flags (enabled unless set to "false"):
# NEXT_PUBLIC_FEATURE_MULTI_ASSET=false
# NEXT_PUBLIC_FEATURE_RECURRING=false
# NEXT_PUBLIC_FEATURE_WEBHOOKS=false
# NEXT_PUBLIC_FEATURE_API_KEYS=false
#
# Opt-in flags (disabled unless set to "true"):
# NEXT_PUBLIC_FEATURE_ADVANCED_ANALYTICS=true
#
# Frontend demo helpers flag; see docs/DEMO_MODE.md for current scope/limits.
# NEXT_PUBLIC_DEMO_MODE=true

# ── Version (Optional) ─────────────────────────────────────────
# NEXT_PUBLIC_APP_VERSION=0.1.0

# ── Transaction Fees (Optional) ────────────────────────────────
# Fee policy applied when building Stellar transactions (issue #825).
# The recommended fee is read from Horizon's /fee_stats percentiles rather
# than hardcoded, so payments clear during congestion.
#
# Aggressiveness selects which recently-charged percentile to bid:
#   low → p50, medium → p90, high → p99. Defaults to medium.
# NEXT_PUBLIC_FEE_AGGRESSIVENESS=medium
#
# How long fee statistics may be reused before refetching, in milliseconds
# (default 30000).
# FEE_STATS_TTL_MS=30000
#
# Last-resort per-operation fee (stroops) used only when Horizon is
# unreachable AND no statistics have ever been fetched (default 100).
# FEE_FALLBACK_BASE_FEE=100

# ── Outbound Request Timeouts (Optional) ───────────────────────
# Every outbound Stellar/Horizon/Soroban/price/webhook call carries an explicit
# timeout so a slow upstream becomes a classified error instead of a hung
# request (issue #747). Values are milliseconds; each falls back to a sane
# default (see docs/TIMEOUTS.md).
# STELLAR_REQUEST_TIMEOUT_MS=10000   # umbrella Stellar budget
# HORIZON_REQUEST_TIMEOUT_MS=10000   # Horizon REST (defaults to Stellar)
# SOROBAN_RPC_TIMEOUT_MS=10000       # Soroban RPC (defaults to Stellar)
# PRICE_REQUEST_TIMEOUT_MS=5000      # XLM price oracles
# WEBHOOK_TIMEOUT_MS=5000            # webhook delivery attempts
# RPC_PROBE_TIMEOUT_MS=3000          # failover health probes
