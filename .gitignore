# dependencies
node_modules/
.pnp/
.pnp.js

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env (use .env.example as template)
# .env.testnet is a deployment artifact written by scripts/deploy-testnet.mjs
# and may contain private key material — never commit it.
.env
.env*.local
.env.testnet

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/dev.db
prisma/dev.db-journal

# IDE
.vscode/
.idea/
*.swp
*.swo

# contracts (keep compiled WASM for deployment)
contracts/**/target/debug/
contracts/**/target/release/
contracts/**/target/wasm32-unknown-unknown/debug/
contracts/**/target/wasm32-unknown-unknown/release/.fingerprint/
contracts/**/target/wasm32-unknown-unknown/release/deps/
contracts/**/target/wasm32-unknown-unknown/release/.cargo-*
contracts/**/target/wasm32-unknown-unknown/release/*.d
contracts/**/target/.rustc_info.json
contracts/**/target/CACHEDIR.TAG
contracts/**/Cargo.lock

# Soroban
.soroban/
contracts/*/target/
contracts/**/spec/target/
.demo-frames/

# Soroban test snapshot artifacts (generated on test failure)
**/test_snapshots/

# Playwright
playwright-report/
test-results/
